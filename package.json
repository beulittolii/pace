{
  "name": "pace-learning",
  "private": true,
  "scripts": {
    "test": "node --test tests/auth.test.cjs tests/vocab-sync.test.cjs tests/vocab-data.test.cjs tests/vocab-modes.test.cjs tests/grammar.test.cjs tests/weekly-review.test.cjs tests/cleanup.test.cjs",
    "test:auth-rules": "firebase emulators:exec --project demo-pace-auth --only firestore 'node --test tests/auth-rules.test.cjs'",
    "test:auth-browser": "node tests/auth-browser.cjs",
    "test:auth-integration": "firebase emulators:exec --project demo-pace-auth --only auth,firestore 'node tests/auth-integration.cjs'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-admin": "13.10.0",
    "firebase-tools": "14.27.0",
    "playwright": "^1.56.0",
    "esbuild": "^0.27.0"
  }
}
